# Copy to .env for local development. Never commit real credentials.
# AGO_DATABASE_URL is used ONLY by Alembic for DDL. Keep it out of the API runtime.
AGO_DATABASE_URL=postgresql+psycopg://localhost/ai_growth_operator
# AGO_APP_DATABASE_URL is used by FastAPI at runtime. It MUST be a non-superuser,
# NOBYPASSRLS role (for example ago_app) so tenant RLS policies are enforced.
AGO_APP_DATABASE_URL=postgresql+psycopg://localhost/ai_growth_operator
AGO_APP_ROLE=ago_app
AGO_COOKIE_SECURE=false
AGO_SESSION_TTL_MINUTES=20160
AGO_SESSION_ABSOLUTE_DAYS=30
